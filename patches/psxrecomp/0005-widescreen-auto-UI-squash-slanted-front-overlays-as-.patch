+/* auto_ui_provenance: a vertex on or beyond a display edge stays there, so an
+ * overlay that covers the 4:3 screen out to its edges (the bow scope's mask
+ * and side panels) still reaches the edges of the wide image after its inner
+ * part is squashed. Everything between keeps the widget's squash. */
+static int32_t ws_shared_ui_delta(void);
+static int32_t ws_ui_item_x(const WsUiPrepassItem *it, int32_t x, double s) {
+    if (ws_ui_provenance()) {
+        const int32_t sx = x + it->ox, X = ws_disp_x(), W = ws_disp_w();
+        if (sx <= X || sx >= X + W) return x;
+    }
+    return ws_ui_x(x, it->group.anchor, s) + ws_shared_ui_delta();
+}

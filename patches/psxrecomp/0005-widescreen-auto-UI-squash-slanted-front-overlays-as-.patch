diff --git a/runtime/tests/test_ws_auto_ui_overlay_mesh_exec.c b/runtime/tests/test_ws_auto_ui_overlay_mesh_exec.c
new file mode 100644
index 0000000..62fbb94
--- /dev/null
+++ b/runtime/tests/test_ws_auto_ui_overlay_mesh_exec.c
@@ -0,0 +1,158 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+/* [widescreen] auto_ui_provenance: a screen-space overlay mesh drawn in front
+ * of the whole world squashes as one piece (Action Man: Mission Xtreme's bow
+ * scope).
+ *
+ *  - The scope mask is a radial mesh of slanted quads with a few axis-aligned
+ *    ones among them. Only the axis-aligned pieces used to squash; the slanted
+ *    ones stayed stretched, tearing holes in the mask and splitting the bow.
+ *    A slanted 2D quad in front of every world primitive is now a HUD
+ *    candidate in its own right and squashes with its run.
+ *  - A vertex on a display edge stays on it, so the mask still covers the
+ *    wide image out to its edges.
+ *  - A slanted 2D quad among the world's ranks keeps the old rule (a widget
+ *    part only when it lies inside an admitted widget).
+ *
+ * Drives the real path: an ordering-table linked list in guest RAM, the UI
+ * prepass, run grouping (real ws_ui_group.c), then GP0 execution. */
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define GPU_EXEC_REAL_UI_GROUP
+#include "../src/gpu.c"
+
+#include "gpu_exec_stubs.inc"
+
+#define OT_HEAD     0x00010000u
+#define NODE_WORLD  0x00010100u   /* projected quad, rank 0                  */
+#define NODE_LOW    0x00010180u   /* slanted 2D quad among the world, rank 0 */
+#define NODE_GAP0   0x00010200u   /* empty: next rank                        */
+#define NODE_SLANT  0x00010300u   /* slanted mask piece, rank 1              */
+#define NODE_STRAIT 0x00010380u   /* axis-aligned mask piece, rank 1         */
+
+static uint32_t pack_vertex(int16_t x, int16_t y) {
+    return (uint16_t)x | ((uint32_t)(uint16_t)y << 16);
+}
+
+static void put_node(uint32_t addr, uint32_t next, const uint32_t *words,
+                     uint32_t count) {
+    test_ram[addr / 4u] = (count << 24) | (next & 0xFFFFFFu);
+    for (uint32_t i = 0; i < count; i++)
+        test_ram[addr / 4u + 1u + i] = words[i];
+}
+
+static void put_poly(uint32_t node, uint32_t next, const int16_t v[4][2]) {
+    const uint32_t q[5] = {
+        0x28000000u,
+        pack_vertex(v[0][0], v[0][1]), pack_vertex(v[1][0], v[1][1]),
+        pack_vertex(v[2][0], v[2][1]), pack_vertex(v[3][0], v[3][1]),
+    };
+    put_node(node, next, q, 5);
+}
+
+static int projected_word(uint32_t addr, uint32_t word) {
+    (void)word;
+    return addr >= NODE_WORLD && addr < NODE_WORLD + 0x20u;
+}
+
+/* A left-hand mask band from the display's left edge to the scope ring
+ * around the centre of a 320-wide display: a slanted piece over the top half
+ * and an axis-aligned piece under it, butted at x 120. */
+static void build(void) {
+    memset(test_ram, 0, sizeof(test_ram));
+    test_ram[OT_HEAD / 4u] = NODE_WORLD;                       /* rank 0 */
+    const int16_t world[4][2] = {{140, 100}, {180, 100}, {140, 140}, {180, 140}};
+    put_poly(NODE_WORLD, NODE_LOW, world);
+    const int16_t low[4][2] = {{200, 20}, {240, 30}, {205, 60}, {250, 70}};
+    put_poly(NODE_LOW, NODE_GAP0, low);
+    test_ram[NODE_GAP0 / 4u] = NODE_SLANT;                     /* rank 1 */
+    const int16_t slant[4][2] = {{0, 0}, {150, 0}, {0, 120}, {120, 120}};
+    put_poly(NODE_SLANT, NODE_STRAIT, slant);
+    const int16_t strait[4][2] = {{0, 120}, {120, 120}, {0, 240}, {120, 240}};
+    put_poly(NODE_STRAIT, 0xFFFFFFu, strait);
+}
+
+static void load_packet(uint32_t node) {
+    for (uint32_t i = 0; i < 5; i++)
+        gp0_cmd_buf[i] = test_ram[node / 4u + 1u + i];
+    gp0_cmd_source_addr = node + 4u;
+    gp0_words_needed = 5;
+}
+
+static void reset_state(void) {
+    s_frame_count = 100;
+    draw_offset_x = draw_offset_y = 0;
+    draw_area_left = 0; draw_area_top = 0;
+    draw_area_right = 1023; draw_area_bottom = 511;
+    hres1 = 1; hres2 = 0; video_mode = 0; display_depth = 0;
+    display_disabled = 0; display_area_x = 0; display_area_y = 0;
+    h_display_x1 = 0x200; h_display_x2 = 0xC00;
+    v_display_y1 = 0x010; v_display_y2 = 0x100;
+    /* Projection-and-stretch path at 16:9: X squash 3/4, not native-wide. */
+    ws_mode = 0;
+    ws_cfg_num = 16; ws_cfg_den = 9;
+    ws_xnum = 3; ws_xden = 4;
+    ws_full_2d = 0;
+    fixture_word_projected = projected_word;
+    gpu_ws_set_auto_ui_squash(1);
+    gpu_ws_set_auto_ui_in_place(0);
+    gpu_ws_set_auto_ui_proportional(0);
+    gpu_ws_set_auto_ui_provenance(1);
+    pgxp_set_enabled(1);
+}
+
+static void run_quad(uint32_t node) {
+    gpu_exec_reset_triangles();
+    load_packet(node);
+    gp0_exec_mono_quad();
+    assert(gpu_exec_triangles.calls >= 1);
+}
+
+int main(void) {
+    reset_state();
+    build();
+    gpu_ws_prepass_linked_list(OT_HEAD);
+    assert(ws_ui_provenance());
+    assert(ws_ui_reject.world == 1);
+    assert(ws_ui_reject.overlay == 1);          /* the slanted mask piece */
+
+    /* Both mask pieces are one run with one anchor. */
+    int slant = -1, strait = -1, low = -1;
+    for (uint32_t i = 0; i < ws_ui_prepass_count; i++) {
+        if (ws_ui_prepass[i].src_addr == NODE_SLANT + 4u) slant = (int)i;
+        if (ws_ui_prepass[i].src_addr == NODE_STRAIT + 4u) strait = (int)i;
+        if (ws_ui_prepass[i].src_addr == NODE_LOW + 4u) low = (int)i;
+    }
+    assert(slant >= 0 && strait >= 0);
+    assert(low < 0);                            /* among the world: not HUD */
+    assert(ws_ui_prepass[slant].group.root == ws_ui_prepass[strait].group.root);
+    const int32_t anchor = ws_ui_prepass[strait].group.anchor;
+    assert(ws_ui_prepass[slant].group.anchor == anchor);
+
+    /* The left edge stays on the display edge; the inner edge squashes about
+     * the run's anchor, identically for the slanted and the straight piece,
+     * so the two stay butted. */
+    const int32_t left = ws_disp_x();
+    run_quad(NODE_STRAIT);
+    assert(gpu_exec_triangles.min_x == left);
+    const int inner = gpu_exec_triangles.max_x;
+    assert(inner == ws_scale_about(120, anchor));
+    assert(inner != 120);
+    run_quad(NODE_SLANT);
+    assert(gpu_exec_triangles.min_x == left);
+    assert(gpu_exec_triangles.max_x == ws_scale_about(150, anchor));
+
+    /* The slanted quad among the world is drawn as the game sent it. */
+    run_quad(NODE_LOW);
+    assert(gpu_exec_triangles.min_x == 200);
+    assert(gpu_exec_triangles.max_x == 250);
+
+    printf("ws_auto_ui_overlay_mesh_exec_test: PASS\n");
+    return 0;
+}

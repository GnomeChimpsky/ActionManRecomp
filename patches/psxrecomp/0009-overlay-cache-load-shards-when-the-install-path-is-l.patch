From 69e09e64a67f219264cf9247e68c1f694d05feb7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 12:20:11 +0000
Subject: [PATCH] overlay cache: load shards when the install path is longer
 than MAX_PATH

A deep install folder (285-character shard paths on the reporter's PC) made
every ANSI Win32 call in the overlay loader fail, so no cached DLL loaded,
everything ran interpreted, and autocapture recompiled every 6 s with a
~120 ms stall each time.

- overlay_win_api_path(): long paths go to Win32/CRT calls with the
  directory part replaced by its 8.3 alias; identity comparisons keep the
  long form.
- canonicalize via GetFinalPathNameByHandleW (no MAX_PATH bound).
- the autocompile --out-dir gets the short alias when the root is deep.
- embed a longPathAware manifest in the Windows exe.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XzXUZq7vwGiGRkJ8nhd4G3
---
 runtime/include/overlay_path_canon.h | 12 +++++
 runtime/runtime.cmake                | 18 ++++++-
 runtime/src/main.cpp                 | 35 +++++++++++++-
 runtime/src/overlay_loader.c         | 38 ++++++++++-----
 runtime/src/overlay_path_canon.c     | 72 ++++++++++++++++++++++++++--
 5 files changed, 156 insertions(+), 19 deletions(-)

diff --git a/runtime/include/overlay_path_canon.h b/runtime/include/overlay_path_canon.h
index bfebc7c..39c4e49 100644
--- a/runtime/include/overlay_path_canon.h
+++ b/runtime/include/overlay_path_canon.h
@@ -32,6 +32,18 @@ int overlay_path_canonicalize(const char *path, char *out, size_t cap);
 int overlay_path_canonicalize_handle(HANDLE h, char *out, size_t cap);
 #endif
 
+/* Path to hand to an ANSI Win32 file API or the CRT. Paths shorter than
+ * OVERLAY_WIN_LONG_PATH come back unchanged. Longer ones would fail against
+ * MAX_PATH (an install folder under a long directory pushes cache shards past
+ * 260 characters, and then no cached DLL ever loads), so the existing
+ * directory part is replaced by its 8.3 short alias and the leaf (a file name,
+ * a not-yet-created file or a FindFirstFile pattern) is appended unchanged.
+ * Returns `in` when shortening is impossible (8.3 names disabled, missing
+ * directory) or off Windows. The result only names the object for the API
+ * call; identity comparisons keep using the long/canonical form. */
+#define OVERLAY_WIN_LONG_PATH 240
+const char *overlay_win_api_path(const char *in, char *buf, size_t cap);
+
 #ifdef __cplusplus
 }
 #endif

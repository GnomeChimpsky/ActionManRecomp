index f3810f0..6d42c59 100644
--- a/runtime/src/main.cpp
+++ b/runtime/src/main.cpp
@@ -18544,6 +18544,39 @@ int main(int argc, char** argv) {
                 if (!line.empty() && std::filesystem::exists(line, cec)) tk_compiler = line;
             }
         }
+        /* The compiler writes shards ~100 characters below the cache root. When
+         * the install folder is deep enough to push those past MAX_PATH,
+         * Python and gcc can only create them on systems with long paths
+         * enabled, so hand them the 8.3 alias of the root instead (same
+         * directory, short spelling). The loader keeps the long form for
+         * identity and shortens only at its own API calls. */
+        auto compiler_cache_dir = [](const std::filesystem::path& dir) {
+            std::string out = dir.string();
+#ifdef _WIN32
+            if (out.size() + 110 >= MAX_PATH) {
+                std::error_code mec;
+                std::filesystem::create_directories(dir, mec);
+                std::wstring wl = L"\\\\?\\" + dir.wstring();
+                if (dir.wstring().rfind(L"\\\\", 0) == 0)
+                    wl = L"\\\\?\\UNC\\" + dir.wstring().substr(2);
+                wchar_t ws[1024];
+                DWORD n = GetShortPathNameW(wl.c_str(), ws, 1024);
+                if (n > 0 && n < 1024) {
+                    std::wstring w(ws, n);
+                    if (w.rfind(L"\\\\?\\UNC\\", 0) == 0) w = L"\\\\" + w.substr(8);
+                    else if (w.rfind(L"\\\\?\\", 0) == 0) w = w.substr(4);
+                    std::string sn = std::filesystem::path(w).string();
+                    if (!sn.empty() && sn.size() < out.size()) {
+                        std::fprintf(stdout,
+                            "psxrecomp: overlay cache path is long (%zu chars); "
+                            "compiler uses short alias %s\n", out.size(), sn.c_str());
+                        out = sn;
+                    }
+                }
+            }
+#endif
+            return out;
+        };
         auto build_toolchain_cmd = [&](const char *compiler) {
             auto cmd_quote = [](const std::string& s) {
                 return std::string("\"") + s + "\"";
@@ -18557,7 +18590,7 @@ int main(int argc, char** argv) {
                 " --recompiler " + cmd_quote((tk_dir / tk_recompiler).string()) +
                 " --runtime-include " + cmd_quote((tk_dir / "include").string()) +
                 " --project-root " + cmd_quote(tk_dir.string()) +
-                " --out-dir " + cmd_quote((tk_xd / "cache").string()) +
+                " --out-dir " + cmd_quote(compiler_cache_dir(tk_xd / "cache")) +
                 (g_psx_cps_mode ? " --cps" : "") +
                 " --compiler " + compiler;
             if (std::string(compiler) == "gcc" && !tk_compiler.empty())

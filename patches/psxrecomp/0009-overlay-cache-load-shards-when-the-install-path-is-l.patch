             FindClose(h2);
             loader_log("*** OVERLAY CACHE HASH MISMATCH: this build reads %s/%s but "
@@ -2075,7 +2081,8 @@ static void abi_preflight_sweep(const char *dir) {
 #ifdef _WIN32
     char marker[900];
     snprintf(marker, sizeof marker, "%s/.abi_%08x.ok", dir, (unsigned)PSX_OVERLAY_ABI_TAG);

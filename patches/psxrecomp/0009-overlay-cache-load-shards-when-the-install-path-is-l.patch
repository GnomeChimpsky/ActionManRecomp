diff --git a/runtime/src/overlay_path_canon.c b/runtime/src/overlay_path_canon.c
index 9485383..1b6541f 100644
--- a/runtime/src/overlay_path_canon.c
+++ b/runtime/src/overlay_path_canon.c
@@ -4,17 +4,24 @@
  * is. */
 #include "overlay_path_canon.h"
 
+#include <stdio.h>
 #include <string.h>
 
 #ifdef _WIN32
 
 int overlay_path_canonicalize_handle(HANDLE h, char *out, size_t cap) {
     if (h == NULL || h == INVALID_HANDLE_VALUE || !out || cap < 2) return 0;
-    char buf[1024];
-    DWORD n = GetFinalPathNameByHandleA(h, buf, (DWORD)sizeof(buf),
+    /* Wide API: the ANSI form is bounded by MAX_PATH on systems without
+     * long-path support, and cache shards can legitimately exceed it. */
+    wchar_t wbuf[1024];
+    DWORD n = GetFinalPathNameByHandleW(h, wbuf, (DWORD)(sizeof(wbuf) / sizeof(wbuf[0])),
                                         FILE_NAME_NORMALIZED |
                                             VOLUME_NAME_DOS);
-    if (n == 0 || n >= sizeof(buf)) return 0;
+    if (n == 0 || n >= sizeof(wbuf) / sizeof(wbuf[0])) return 0;
+    char buf[1024];
+    int bn = WideCharToMultiByte(CP_ACP, 0, wbuf, (int)n + 1, buf,
+                                 (int)sizeof(buf), NULL, NULL);
+    if (bn <= 0) return 0;
     /* Strip the \\?\ (or rewrite \\?\UNC\ to \\) prefix so the result
      * compares against ordinary Win32 paths. */
     const char *p = buf;
@@ -34,11 +41,62 @@ int overlay_path_canonicalize_handle(HANDLE h, char *out, size_t cap) {
     return 1;
 }
 
+const char *overlay_win_api_path(const char *in, char *buf, size_t cap) {
+    if (!in || !buf || cap < 8 || strlen(in) < OVERLAY_WIN_LONG_PATH) return in;
+    /* Only absolute drive or UNC paths can take the \\?\ prefix. */
+    int drive = in[0] && in[1] == ':' && (in[2] == '\\' || in[2] == '/');
+    int unc = (in[0] == '\\' || in[0] == '/') && (in[1] == '\\' || in[1] == '/');
+    if (!drive && !unc) return in;
+    const char *s1 = strrchr(in, '/');
+    const char *s2 = strrchr(in, '\\');
+    const char *sep = (s1 > s2) ? s1 : s2;
+    if (!sep || sep == in) return in;
+    char dir[1024];
+    size_t dlen = (size_t)(sep - in);
+    if (dlen + 8 >= sizeof(dir)) return in;
+    if (unc) {
+        memcpy(dir, "\\\\?\\UNC\\", 8);
+        memcpy(dir + 8, in + 2, dlen - 2);
+        dir[8 + dlen - 2] = '\0';
+    } else {
+        memcpy(dir, "\\\\?\\", 4);
+        memcpy(dir + 4, in, dlen);
+        dir[4 + dlen] = '\0';
+    }
+    for (char *q = dir; *q; q++) if (*q == '/') *q = '\\';
+    wchar_t wdir[1024], wshort[1024];
+    if (MultiByteToWideChar(CP_ACP, 0, dir, -1, wdir,
+                            (int)(sizeof(wdir) / sizeof(wdir[0]))) <= 0)
+        return in;
+    DWORD n = GetShortPathNameW(wdir, wshort,
+                                (DWORD)(sizeof(wshort) / sizeof(wshort[0])));
+    if (n == 0 || n >= sizeof(wshort) / sizeof(wshort[0])) return in;
+    char sdir[1024];
+    if (WideCharToMultiByte(CP_ACP, 0, wshort, -1, sdir, (int)sizeof(sdir),
+                            NULL, NULL) <= 0)
+        return in;
+    const char *sp = sdir;
+    char sunc[1024];
+    if (strncmp(sdir, "\\\\?\\UNC\\", 8) == 0) {
+        sunc[0] = '\\';
+        sunc[1] = '\\';
+        strncpy(sunc + 2, sdir + 8, sizeof(sunc) - 3);
+        sunc[sizeof(sunc) - 1] = '\0';
+        sp = sunc;
+    } else if (strncmp(sdir, "\\\\?\\", 4) == 0) {
+        sp = sdir + 4;
+    }
+    int w = snprintf(buf, cap, "%s\\%s", sp, sep + 1);
+    if (w < 0 || (size_t)w >= cap || (size_t)w >= strlen(in)) return in;
+    return buf;
+}
+
 int overlay_path_canonicalize(const char *path, char *out, size_t cap) {
     if (!path || !path[0]) return 0;
     /* dwDesiredAccess=0 opens for attribute access only (works even on
      * read-locked files); BACKUP_SEMANTICS is required to open directories. */
-    HANDLE h = CreateFileA(path, 0,
+    char api[1024];
+    HANDLE h = CreateFileA(overlay_win_api_path(path, api, sizeof api), 0,
                            FILE_SHARE_READ | FILE_SHARE_WRITE |
                                FILE_SHARE_DELETE,
                            NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS,
@@ -68,4 +126,10 @@ int overlay_path_canonicalize(const char *path, char *out, size_t cap) {
     return 1;
 }
 
+const char *overlay_win_api_path(const char *in, char *buf, size_t cap) {
+    (void)buf;
+    (void)cap;
+    return in;
+}
+
 #endif

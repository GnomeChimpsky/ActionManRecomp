     if (h == INVALID_HANDLE_VALUE) return;
     do {
         uint32_t addr = 0, crc = 0;
@@ -1971,14 +1975,16 @@ static void warn_on_cgtag_mismatch(const char *tier) {
              (unsigned)s_config_hash, (unsigned)PSX_OVERLAY_FLAVOR);
     snprintf(pattern, sizeof pattern, "%s/cg*", base);
     WIN32_FIND_DATAA fd;
-    HANDLE h = FindFirstFileA(pattern, &fd);
+    char api_pattern[1024];
+    HANDLE h = FindFirstFileA(overlay_win_api_path(pattern, api_pattern, sizeof api_pattern), &fd);
     if (h == INVALID_HANDLE_VALUE) return;
     do {
         if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) continue;

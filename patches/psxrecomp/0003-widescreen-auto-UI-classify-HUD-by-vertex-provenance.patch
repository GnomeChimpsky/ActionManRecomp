+
+/* GP0 word indices of a drawing command's vertices (polygons, single lines,
+ * rectangles); 0 for anything else (poly-lines, transfers, state). */
+static int ws_gp0_vertex_words(uint8_t op, int idx[4]) {
+    if (op >= 0x20u && op <= 0x3Fu) {
+        const int quad = (op & 0x08u) != 0;
+        const int step = 1 + ((op & 0x04u) ? 1 : 0) + ((op & 0x10u) ? 1 : 0);
+        const int n = quad ? 4 : 3;
+        for (int i = 0; i < n; i++) idx[i] = 1 + i * step;
+        return n;
+    }
+    if (op >= 0x40u && op <= 0x5Fu && !(op & 0x08u)) {
+        idx[0] = 1;
+        idx[1] = (op & 0x10u) ? 3 : 2;
+        return 2;
+    }
+    if (op >= 0x60u && op <= 0x7Fu) { idx[0] = 1; return 1; }
+    return 0;
+}
+
+/* Vertices of a command whose words were produced by a GTE projection
+ * (pgxp_word_projected). `addr` is the command's first word in RAM. */
+static int ws_gp0_projected_vertices(const uint32_t *words, uint32_t addr) {
+    int idx[4];
+    const int n = ws_gp0_vertex_words((uint8_t)(words[0] >> 24), idx);
+    int projected = 0;
+    if (addr == 0xFFFFFFFFu) return 0;
+    for (int i = 0; i < n; i++)
+        projected += pgxp_word_projected(addr + (uint32_t)idx[i] * 4u,
+                                         words[idx[i]]) ? 1 : 0;
+    return projected;
+}
+
+/* auto_ui_provenance: GTE-projected primitives of the walked list, kept aside
+ * (screen-space bounds) so a 3D icon inside an admitted HUD box can follow it. */
+#define WS_UI_FOLLOW_MAX 512u
+typedef struct {
+    int32_t x0, x1, y0, y1;          /* screen space, display-relative X     */
+    int32_t ox, oy;
+    uint32_t src_addr;
+    uint16_t ot_rank;
+    uint8_t  op;
+    WsPrepassPacketGuard packet_guard;
+} WsUiFollower;
+static WsUiFollower ws_ui_followers[WS_UI_FOLLOW_MAX];
+static uint32_t ws_ui_follower_count;

diff --git a/runtime/tests/test_ws_auto_ui_provenance_exec.c b/runtime/tests/test_ws_auto_ui_provenance_exec.c
new file mode 100644
index 00000000..9f2040c6
--- /dev/null
+++ b/runtime/tests/test_ws_auto_ui_provenance_exec.c
@@ -0,0 +1,179 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+/* [widescreen] auto_ui_provenance: HUD against world by where vertices came
+ * from, not by ordering-table rank (Action Man: Mission Xtreme).
+ *
+ *  - An axis-aligned quad whose vertex words carry a GTE projection is world
+ *    geometry even right next to the HUD (the language screen's waving flag:
+ *    cells squashed as HUD left black holes that flickered as it waved).
+ *  - A HUD box drawn as a translucent fill plus GP0 0x40 line outline, at
+ *    different OT ranks, squashes as one widget: the outline moves with the
+ *    fill (the outlines were never admitted and stayed stretched).
+ *  - 2D drawn behind the 3D scene (a backdrop) is not HUD.
+ *  - A projected icon inside a small HUD box moves with the box (the vehicle
+ *    model in the HUD box drifted out of it).
+ *
+ * Drives the real path: an ordering-table linked list in guest RAM, the UI
+ * prepass, run grouping (real ws_ui_group.c), then GP0 execution. */
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define GPU_EXEC_REAL_UI_GROUP
+#include "../src/gpu.c"
+
+#include "gpu_exec_stubs.inc"
+
+#define OT_HEAD    0x00010000u
+#define NODE_BACK  0x00010100u   /* 2D backdrop tile, behind the world      */
+#define NODE_GAP0  0x00010200u   /* empty: next rank                        */
+#define NODE_WORLD 0x00010300u   /* projected axis-aligned quad (flag cell) */
+#define NODE_ICON  0x00010380u   /* projected icon inside the HUD box        */
+#define NODE_GAP1  0x00010400u   /* empty: next rank                        */
+#define NODE_FILL  0x00010500u   /* HUD box fill (0x2A)                     */
+#define NODE_GAP2  0x00010600u   /* empty: next rank                        */
+#define NODE_LINE  0x00010700u   /* + 0x10 per outline line                 */
+
+static uint32_t pack_vertex(int16_t x, int16_t y) {
+    return (uint16_t)x | ((uint32_t)(uint16_t)y << 16);
+}
+
+static void put_node(uint32_t addr, uint32_t next, const uint32_t *words,
+                     uint32_t count) {
+    test_ram[addr / 4u] = (count << 24) | (next & 0xFFFFFFu);
+    for (uint32_t i = 0; i < count; i++)
+        test_ram[addr / 4u + 1u + i] = words[i];
+}
+
+static void put_quad(uint32_t node, uint32_t next, int16_t x0, int16_t x1,
+                     int16_t y0, int16_t y1, uint32_t cmd) {
+    const uint32_t q[5] = {
+        cmd, pack_vertex(x0, y0), pack_vertex(x1, y0),
+        pack_vertex(x0, y1), pack_vertex(x1, y1),
+    };
+    put_node(node, next, q, 5);
+}
+
+static int projected_word(uint32_t addr, uint32_t word) {
+    (void)word;
+    return (addr >= NODE_WORLD && addr < NODE_WORLD + 0x20u) ||
+           (addr >= NODE_ICON && addr < NODE_ICON + 0x20u);
+}
+
+/* HUD box [20,100) x [180,230) at the left of a 320-wide display: a fill at
+ * one rank and its four outline lines two ranks further front. */
+static void build(void) {
+    memset(test_ram, 0, sizeof(test_ram));
+    test_ram[OT_HEAD / 4u] = NODE_BACK;                     /* rank 0 */
+    put_quad(NODE_BACK, NODE_GAP0, 120, 140, 20, 40, 0x28202020u);
+    test_ram[NODE_GAP0 / 4u] = NODE_WORLD;                  /* rank 1 */
+    put_quad(NODE_WORLD, NODE_ICON, 100, 112, 160, 170, 0x28FF0000u);
+    put_quad(NODE_ICON, NODE_GAP1, 50, 70, 195, 215, 0x2800FF00u);
+    test_ram[NODE_GAP1 / 4u] = NODE_FILL;                   /* rank 2 */
+    /* Opaque here so the stub records it as triangles (a translucent fill
+     * draws through gr_draw_flat_rect); classification is the same. */
+    put_quad(NODE_FILL, NODE_GAP2, 20, 100, 180, 230, 0x28404040u);
+    test_ram[NODE_GAP2 / 4u] = NODE_LINE;                   /* rank 3 */
+    const int16_t lines[4][4] = {
+        {20, 180, 100, 180}, {20, 230, 100, 230},
+        {20, 180, 20, 230}, {100, 180, 100, 230},
+    };
+    for (int i = 0; i < 4; i++) {
+        const uint32_t w[3] = {
+            0x40FFFFFFu, pack_vertex(lines[i][0], lines[i][1]),
+            pack_vertex(lines[i][2], lines[i][3]),
+        };
+        put_node(NODE_LINE + 0x10u * (uint32_t)i,
+                 i < 3 ? NODE_LINE + 0x10u * (uint32_t)(i + 1) : 0xFFFFFFu, w, 3);
+    }
+}
+
+static void load_packet(uint32_t node, uint32_t count) {
+    for (uint32_t i = 0; i < count; i++)
+        gp0_cmd_buf[i] = test_ram[node / 4u + 1u + i];
+    gp0_cmd_source_addr = node + 4u;
+    gp0_words_needed = (int)count;
+}
+
+static void reset_state(int provenance) {
+    s_frame_count = 100;
+    draw_offset_x = draw_offset_y = 0;
+    draw_area_left = 0; draw_area_top = 0;
+    draw_area_right = 1023; draw_area_bottom = 511;
+    hres1 = 1; hres2 = 0; video_mode = 0; display_depth = 0;
+    display_disabled = 0; display_area_x = 0; display_area_y = 0;
+    h_display_x1 = 0x200; h_display_x2 = 0xC00;
+    v_display_y1 = 0x010; v_display_y2 = 0x100;
+    /* Projection-and-stretch path at 16:9: X squash 3/4, not native-wide. */
+    ws_mode = 0;
+    ws_cfg_num = 16; ws_cfg_den = 9;
+    ws_xnum = 3; ws_xden = 4;
+    ws_full_2d = 0;
+    fixture_word_projected = projected_word;
+    gpu_ws_set_auto_ui_squash(1);
+    gpu_ws_set_auto_ui_in_place(0);
+    gpu_ws_set_auto_ui_proportional(0);
+    gpu_ws_set_auto_ui_provenance(provenance);
+    pgxp_set_enabled(provenance);
+}
+
+static int quad_min_x(uint32_t node) {
+    gpu_exec_reset_triangles();
+    load_packet(node, 5);
+    gp0_exec_mono_quad();
+    assert(gpu_exec_triangles.calls >= 1);
+    return gpu_exec_triangles.min_x;
+}
+
+static int line_x0(int i) {
+    gpu_exec_line.calls = 0;
+    load_packet(NODE_LINE + 0x10u * (uint32_t)i, 3);
+    gp0_exec_mono_line();
+    assert(gpu_exec_line.calls == 1);
+    return gpu_exec_line.x0;
+}
+
+int main(void) {
+    /* Rank-based (provenance off): only the front rank, the outline lines,
+     * is a candidate, and lines are not admitted at all. */
+    reset_state(0);
+    build();
+    gpu_ws_prepass_linked_list(OT_HEAD);
+    assert(ws_ui_prepass_count == 0);
+    assert(line_x0(2) == 20);                      /* outline stays wide */
+
+    reset_state(1);
+    build();
+    gpu_ws_prepass_linked_list(OT_HEAD);
+    assert(ws_ui_provenance());
+    assert(ws_ui_reject.world == 2);               /* world cell + icon */
+    assert(ws_ui_reject.behind == 1);              /* the backdrop tile */
+    assert(ws_ui_reject.follow == 1);              /* the icon follows the box */
+    assert(ws_ui_prepass_count == 1 + 4 + 1);      /* fill + 4 lines + icon */
+
+    /* The box squashes toward the left edge, its outline with it. */
+    const int32_t left = ws_disp_x();
+    const int fill_x = quad_min_x(NODE_FILL);
+    assert(fill_x == ws_scale_about(20, left));
+    assert(line_x0(2) == fill_x);                  /* left edge */
+    assert(line_x0(3) == ws_scale_about(100, left)); /* right edge */
+    assert(line_x0(0) == fill_x);                  /* top edge start */
+
+    /* World geometry next to the HUD is untouched; the backdrop too. */
+    assert(quad_min_x(NODE_WORLD) == 100);
+    assert(quad_min_x(NODE_BACK) == 120);
+
+    /* The projected icon was squashed about the display centre with the
+     * world (c + (x - c) * 3/4); it moves by (left - c) * (1 - 3/4) so it
+     * lands where the box's own transform puts that point. */
+    const int c = 160;
+    const int icon_x = quad_min_x(NODE_ICON);
+    assert(icon_x == 50 + (int)lround((left - c) * 0.25));
+
+    printf("ws_auto_ui_provenance_exec_test: PASS\n");
+    return 0;
+}

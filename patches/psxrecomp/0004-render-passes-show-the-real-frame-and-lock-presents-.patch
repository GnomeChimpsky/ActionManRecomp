diff --git a/runtime/src/render_pass_projection.cpp b/runtime/src/render_pass_projection.cpp
index f264f1bb..6e7b2889 100644
--- a/runtime/src/render_pass_projection.cpp
+++ b/runtime/src/render_pass_projection.cpp
@@ -4,6 +4,7 @@
 #include "psx_cycle_freeze.h"
 #include <algorithm>
 #include <cmath>
+#include <cstdlib>
 #include <cstring>
 #include <new>
 #include <unordered_map>
@@ -74,6 +75,11 @@ struct PSXProjectionHistory {
     double alpha = 1;
 };
 static PSXProjectionHistory* active = nullptr;
+// Diagnostic total: replay projections left at their current matrix (no match
+// or a cut). Kept out of PSXProjectionStats, whose header is an execution
+// contract input (changing it changes the save-state identity).
+static uint32_t s_replay_kept = 0;
+extern "C" uint32_t psx_projection_replay_kept_total(void) { return s_replay_kept; }
 // Intrusive list has no global destructor: title replay objects may release
 // their histories from static destructors, in either link initialization order.
 static PSXProjectionHistory* histories = nullptr;
@@ -157,6 +163,14 @@ extern "C" void psx_projection_replay_begin(PSXProjectionHistory* h, uint32_t al
     h->capturing = false; h->replaying = true;
     h->used.assign(h->current.size(), 0);
     h->alpha = std::min(alpha, 65536u) / 65536.0;
+    // Diagnostic: PSX_RENDER_PASS_ALPHA (0..1) draws every pass at that phase.
+    // At 0 a pass should equal the previous frame wherever motion is blended.
+    static double forced = -2;
+    if (forced == -2) {
+        const char* e = std::getenv("PSX_RENDER_PASS_ALPHA");
+        forced = e && *e ? std::atof(e) : -1;
+    }
+    if (forced >= 0 && forced <= 1) h->alpha = forced;
     h->stats.replayed = 0; active = h; g_psx_projection_command = psx_projection_command;
 }
 extern "C" void psx_projection_replay_end(PSXProjectionHistory* h) {
@@ -183,16 +197,18 @@ extern "C" int psx_projection_command(CPUState* cpu, uint32_t command) {
     }
     if (!h->replaying || !g_psx_render_pass_active) return 0;
     auto it = h->index.find(p.key);
-    if (it == h->index.end()) return 0;
+    if (it == h->index.end()) { ++s_replay_kept; return 0; }
     for (uint32_t i : it->second) {
         const auto& c = h->current[i];
         if (h->used[i] || !same_vertices(c,p) || !same_matrix(c.current,p.current)) continue;
         h->used[i] = 1;
-        if (!c.blend || same_matrix(c.previous,c.current)) return 0;
+        if (!c.blend) { ++s_replay_kept; return 0; }
+        if (same_matrix(c.previous,c.current)) return 0;
         PSXMotionMatrix intermediate;
         psx_motion_blend_matrix(&c.previous, &c.current, h->alpha, 1.2, &intermediate);
         set_matrix(cpu, intermediate); ++h->stats.replayed;
         return 1;
     }
+    ++s_replay_kept;
     return 0;
 }

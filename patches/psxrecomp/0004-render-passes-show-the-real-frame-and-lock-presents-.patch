@@ -7811,14 +7819,23 @@ static void interp_present_source_interval(void) {
             s_interp_phase_lo, s_interp_phase_hi))
         return;
     pass_apply_promotion();
+    /* A whole-multiple rate keeps its output grid on the source interval:
+     * exactly m deadlines, the last at the interval's end. */

@@ -9157,7 +9177,27 @@ static int xr_mirror_active(void) {
 /* Draw two presented images crossfaded (t = weight of b) into the window. */
 static int interp_present_pair(GLuint a, GLuint b, float t, int blend_mode);
 
-static int pass_gen_present(uint64_t deadline) {
+/* Output presents per source interval when the output rate is a whole
+ * multiple of the guest VBlank rate (50 FPS on PAL = 1, 100 = 2), else 0. */
+static uint32_t interp_presents_per_interval(void) {
+    double m;
+    if (!(s_interp_source_hz > 0.0) || !(s_interp_target_hz > 0.0)) return 0;
+    m = s_interp_target_hz / s_interp_source_hz;
+    if (m < 0.5 || fabs(m - floor(m + 0.5)) > 1e-3) return 0;
+    return (uint32_t)floor(m + 0.5);
+}
+/* The generation phase of the next present of this interval, counted in
+ * VBlanks rather than read from the host clock: -1 = use the clock (rates
+ * that are not a whole multiple), -2 = this interval's presents are done. */
+static double pass_frame_phase(void) {
+    const uint32_t m = interp_presents_per_interval();
+    if (!m) return -1.0;
+    if (s_interval_presents >= m) return -2.0;
+    return s_interp_phase_lo + (s_interp_phase_hi - s_interp_phase_lo) *
+           ((double)s_interval_presents / (double)m);
+}
+
+static int pass_gen_present(uint64_t deadline, double frame_p) {
     PassGen *g = &s_pgen[s_pgen_cur];
     uint32_t lo = 0, hi = 0;
     float t = 0.0f;
@@ -9166,7 +9206,22 @@ static int pass_gen_present(uint64_t deadline) {
     if (g->source_path != s_interp_source_path || g->tex_w != s_interp_w ||
         g->tex_h != s_interp_h)
         return 0;
-    p = ((double)deadline - g->t_start) / g->t_len;
+    /* A deadline ends the output period it fills: the schedule's first
+     * deadline in a promoted interval lies one target period after the
+     * interval starts, and the generation's last one at its very end. Read
+     * each deadline as the start of the period it ends, so the real frame
+     * (phase 0) is shown first and the in-betweens follow at the phases they
+     * were drawn for. Without this the real frame was never shown at 50 FPS
+     * (deadlines at p = 0.5 and 1.0 both showed the in-between) and only for
+     * a few milliseconds at 100. */
+    p = ((double)deadline - s_interp_schedule.target_period - g->t_start) / g->t_len;
+    if (p < 0.0) p = 0.0;
+    /* A whole-multiple rate takes the phase from the VBlank count instead:
+     * when the guest runs a little behind the host clock (a heavy scene at
+     * 0.98x), clock phases slid against the VBlanks and two presents landed
+     * in one VBlank, the next none -- the in-between shown twice and the
+     * real frame not at all, for seconds at a time. */
+    if (frame_p >= 0.0 && p <= RENDER_PASS_GEN_HOLD_MAX) p = frame_p;
     /* Past phase 1 the next flip is late (a lagging tick): the newest image
      * holds until it comes. Only a game that stops flipping for several
      * frame lengths expires the generation. */
@@ -9175,6 +9230,8 @@ static int pass_gen_present(uint64_t deadline) {
         s_pgen_expired++;
         return 0;
     }
+    s_plog_pass = 1; s_plog_order = g->order; s_plog_p = p;
+    s_plog_lo = lo; s_plog_n = g->n;
     if (!interp_present_pair(s_pgen_tex[s_pgen_cur][lo],
                              s_pgen_tex[s_pgen_cur][hi], t, s_interp_blend_mode))
         return 0;
@@ -9193,13 +9250,18 @@ void gl_renderer_pass_service_presents(void) {
     double sp;
     if (!gl_renderer_pass_ready() || s_pass_active) return;
     sp = (double)SDL_GetPerformanceFrequency() / s_interp_source_hz;
+    /* Frame-locked rates present only this interval's own deadlines here. */
+    if (interp_presents_per_interval()) sp = 0.0;
     while (frame_interpolation_schedule_due(
                &s_interp_schedule, SDL_GetPerformanceCounter(),
                s_interp_schedule.frame_end + sp, &deadline)) {
+        const double frame_p = pass_frame_phase();
+        if (frame_p == -2.0) break;
         latency_ring_mark(LAT_SWAP_BEGIN);
-        if (!pass_gen_present(deadline)) { latency_ring_mark(LAT_SWAP_END); break; }
+        if (!pass_gen_present(deadline, frame_p)) { latency_ring_mark(LAT_SWAP_END); break; }
         latency_ring_mark(LAT_SWAP_END);
         frame_interpolation_schedule_consume(&s_interp_schedule);
+        s_interval_presents++;
         s_pgen_early++;
     }
 }
@@ -9294,9 +9356,12 @@ static void pass_dump_generation(int gi) {
         FILE *f;
         glBindTexture(GL_TEXTURE_2D, s_pgen_tex[gi][i]);
         glGetTexImage(GL_TEXTURE_2D, 0, GL_RGB, GL_UNSIGNED_BYTE, rgb);
-        snprintf(path, sizeof path, "%s/g%03llu_%02u_a%05u.png", s_pdump_dir,
+        /* o<order>: the generation's open sequence, so a generation that
+         * was never promoted shows as a gap; p<period>: its VBlanks. */
+        snprintf(path, sizeof path, "%s/g%03llu_%02u_a%05u_o%06llu_p%u.png", s_pdump_dir,
                  (unsigned long long)s_pdump_gen, (unsigned)i,
-                 (unsigned)g->phase[i]);
+                 (unsigned)g->phase[i], (unsigned long long)g->order,
+                 (unsigned)g->period);
         f = fopen(path, "wb");
         if (f) { (void)png_write_rgb(f, rgb, (uint32_t)g->tex_w, (uint32_t)g->tex_h); fclose(f); }
     }
@@ -9909,6 +9974,29 @@ static void gl_swap_with_osd(void) {
     gl_swap_now(s_fg_presenting);
 }
 
+/* PSX_PRESENT_LOG=<file> (diagnostic): one line per swap -- host time before
+ * and after the swap (us), guest frame, present path, and for a render-pass
+ * present the generation order, its phase p and the image index shown. */
+static FILE    *s_plog = NULL;
+static int      s_plog_init = 0;
+static void present_log_swap(uint64_t t0, uint64_t t1) {
+    if (!s_plog_init) {
+        const char *e = getenv("PSX_PRESENT_LOG");
+        s_plog_init = 1;
+        if (e && *e) {
+            s_plog = fopen(e, "w");
+            if (s_plog) setvbuf(s_plog, NULL, _IOFBF, 1 << 20);
+        }
+    }
+    if (!s_plog) return;
+    const double us = 1.0e6 / (double)SDL_GetPerformanceFrequency();
+    fprintf(s_plog, "%.1f %.1f %llu %d %d %llu %.4f %u %u\n", (double)t0 * us,
+            (double)t1 * us, (unsigned long long)s_frame_count, s_last_present_path,
+            s_plog_pass, (unsigned long long)s_plog_order, s_plog_p,
+            (unsigned)s_plog_lo, (unsigned)s_plog_n);
+    s_plog_pass = 0;
+}
+
 /* The swap itself (and its accounting). */
 static void gl_swap_now(int generated) {
     (void)generated;
@@ -9920,7 +10008,9 @@ static void gl_swap_now(int generated) {
     s_swaps_total++;
     uint64_t t0 = s_dyn_on ? SDL_GetPerformanceCounter() : 0;
     const uint64_t rthf_t0 = rth_replaying() ? host_now_ns_rthf() : 0;
+    const uint64_t plog_t0 = SDL_GetPerformanceCounter();
     gl_present_swap();
+    present_log_swap(plog_t0, SDL_GetPerformanceCounter());
     if (rthf_t0) {
         const uint64_t sw = host_now_ns_rthf() - rthf_t0;
         s_rthf_swap_ns += sw;

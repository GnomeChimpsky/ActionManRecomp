From c33fe5fce731f3e95a4f36cdc8a16c7a606e98d5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 2 Nov 2026 11:06:58 +0000
Subject: [PATCH] PSX launcher: show Render thread / Present thread on the deep
 display card

The rows only existed on the legacy (non-PSX) display card. Smooth motion
(generic frame generation) is not offered: Action Man's Frame Rate mod
replaces it, and a value saved by an earlier build is cleared. Both rows
are greyed out while the Frame Rate mod is enabled, because the runtime
does not start the render thread under interpolated rendering.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/backends/imgui/launcher_imgui.cpp | 50 ++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/src/common/backends/imgui/launcher_imgui.cpp b/src/common/backends/imgui/launcher_imgui.cpp
index 4dc73c7..b249d02 100644
--- a/src/common/backends/imgui/launcher_imgui.cpp
+++ b/src/common/backends/imgui/launcher_imgui.cpp
@@ -3906,6 +3906,21 @@ void draw_quality_preset_row(LauncherModel* m, const LauncherTheme& th) {
     }
 }
 
+// True while Action Man's Frame Rate mod (interpolated rendering) is enabled
+// on the Mods page.
+static bool frame_rate_mod_enabled(const LauncherModel* m) {
+    const auto* mods = m ? m->mods : nullptr;
+    if (!mods || !mods->feature_count || !mods->feature_get) return false;
+    const int count = mods->feature_count(mods->ctx);
+    for (int index = 0; index < count; ++index) {
+        RecompLauncherCModFeature feature{};
+        if (mods->feature_get(mods->ctx, index, &feature) && feature.enabled &&
+            strcmp(feature.package_id, "amx.enhancement.frame-rate") == 0)
+            return true;
+    }
+    return false;
+}
+
 void draw_display_controls(LauncherModel* m, const LauncherTheme& th) {
     eyebrow("DISPLAY");
     draw_quality_preset_row(m, th);
@@ -4318,6 +4333,41 @@ void draw_display_controls(LauncherModel* m, const LauncherTheme& th) {
         }
     }
 
+    // Render pipeline (OpenGL): render thread and present thread. The legacy
+    // card above draws these rows; the deep PSX surface did not. Smooth motion
+    // (generic frame generation) is deliberately not offered: the title's
+    // Frame Rate mod replaces it, and it stutters and flickers textures here.
+    // A value saved by an earlier build is cleared so it cannot stay on.
+    if (launcher_model_render_pipeline_offered(m)) {
+        m->s.frame_generation = 0;
+        // The Frame Rate mod's interpolated rendering runs without the render
+        // thread (the runtime does not start it), so both rows are inert then.
+        const bool fr_mod = frame_rate_mod_enabled(m);
+        static const char* const kFrameRateModNote =
+            "\nNot used while the Action Man Frame Rate mod is on.";
+        ImGui::BeginDisabled(fr_mod);
+        row_label_right("Render thread", th, cb);
+        bool rt = m->s.render_thread != 0;
+        if (ImGui::Checkbox("##render_thread_deep", &rt))
+            m->s.render_thread = rt ? 1 : 0;
+        if (ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal | ImGuiHoveredFlags_AllowWhenDisabled))
+            ImGui::SetTooltip("Draws on a separate thread so the game keeps running while a frame renders.\n"
+                              "Turn off if you see stutter or glitches. Applies at next launch.%s",
+                              fr_mod ? kFrameRateModNote : "");
+        const bool kids = launcher_model_render_pipeline_children_enabled(m);
+        ImGui::BeginDisabled(!kids);
+        row_label_right("Present thread", th, cb);
+        bool pt = m->s.present_thread != 0;
+        if (ImGui::Checkbox("##present_thread_deep", &pt))
+            m->s.present_thread = pt ? 1 : 0;
+        if (ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal | ImGuiHoveredFlags_AllowWhenDisabled))
+            ImGui::SetTooltip("Shows finished frames from another thread so waiting for the display never stalls drawing.\n"
+                              "Needs Render thread. Applies at next launch.%s",
+                              fr_mod ? kFrameRateModNote : "");
+        ImGui::EndDisabled();
+        ImGui::EndDisabled();
+    }
+
     // Frame interpolation is only meaningful under OpenGL (Software has no
     // interpolation pass); Presentation target only matters once frame
     // interpolation is actually on.
-- 

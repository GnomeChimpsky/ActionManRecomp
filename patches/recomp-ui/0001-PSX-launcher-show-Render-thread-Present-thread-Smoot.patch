From 26e3ead29ef51816a27e8c1c4a1ce13f5a28e54e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 18:52:14 +0200
Subject: [PATCH] PSX launcher: show Render thread / Present thread / Smooth
 motion on the deep display card; add Smooth motion to the in-game menu

The rows only existed on the legacy (non-PSX) display card, so PSX titles
could never enable frame generation from the launcher.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/common/backends/imgui/launcher_imgui.cpp | 31 ++++++++++++++++++++
 src/consoles/psx/psx_menu_provider.cpp       |  9 ++++--
 2 files changed, 38 insertions(+), 2 deletions(-)

diff --git a/src/common/backends/imgui/launcher_imgui.cpp b/src/common/backends/imgui/launcher_imgui.cpp
index 4dc73c7..b51b3a4 100644
--- a/src/common/backends/imgui/launcher_imgui.cpp
+++ b/src/common/backends/imgui/launcher_imgui.cpp
@@ -4318,6 +4318,37 @@ void draw_display_controls(LauncherModel* m, const LauncherTheme& th) {
         }
     }
 
+    // Render pipeline (OpenGL): render thread, present thread and Smooth
+    // motion (frame generation). The legacy card above draws these rows; the
+    // deep PSX surface did not, so PSX titles could never reach Smooth motion
+    // from the launcher. Same gating and semantics as the legacy rows.
+    if (launcher_model_render_pipeline_offered(m)) {
+        row_label_right("Render thread", th, cb);
+        bool rt = m->s.render_thread != 0;
+        if (ImGui::Checkbox("##render_thread_deep", &rt))
+            m->s.render_thread = rt ? 1 : 0;
+        if (ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal))
+            ImGui::SetTooltip("Draws on a separate thread so the game keeps running while a frame renders.\n"
+                              "Turn off if you see stutter or glitches. Applies at next launch.");
+        const bool kids = launcher_model_render_pipeline_children_enabled(m);
+        ImGui::BeginDisabled(!kids);
+        row_label_right("Present thread", th, cb);
+        bool pt = m->s.present_thread != 0;
+        if (ImGui::Checkbox("##present_thread_deep", &pt))
+            m->s.present_thread = pt ? 1 : 0;
+        if (ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal | ImGuiHoveredFlags_AllowWhenDisabled))
+            ImGui::SetTooltip("Shows finished frames from another thread so waiting for the display never stalls drawing.\n"
+                              "Needs Render thread. Applies at next launch.");
+        row_label_right("Smooth motion", th, cb);
+        bool fg = m->s.frame_generation != 0;
+        if (ImGui::Checkbox("##frame_generation_deep", &fg))
+            m->s.frame_generation = fg ? 1 : 0;
+        if (ImGui::IsItemHovered(ImGuiHoveredFlags_DelayNormal | ImGuiHoveredFlags_AllowWhenDisabled))
+            ImGui::SetTooltip("Adds extra in-between frames up to your display's refresh rate, made from the camera.\n"
+                              "Adds up to one frame of delay. Needs Render thread. Applies at next launch.");
+        ImGui::EndDisabled();
+    }
+
     // Frame interpolation is only meaningful under OpenGL (Software has no
     // interpolation pass); Presentation target only matters once frame
     // interpolation is actually on.
diff --git a/src/consoles/psx/psx_menu_provider.cpp b/src/consoles/psx/psx_menu_provider.cpp
index f5be1a8..3025440 100644
--- a/src/consoles/psx/psx_menu_provider.cpp
+++ b/src/consoles/psx/psx_menu_provider.cpp
@@ -45,6 +45,9 @@ RecompRuntimeUiItem g_extra[] = {
     {"graphics.render_thread", "Graphics", "Render thread",
      "Use a second CPU thread; restarts when this menu closes.",
      RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr},
+    {"graphics.frame_generation", "Graphics", "Smooth motion",
+     "In-between frames up to the display refresh (OpenGL, needs Render thread).",
+     RECOMP_RUNTIME_UI_BOOL, 0, 1, 1, nullptr, 0, nullptr},
     {"media.disc", "Disc", "Selected disc", "Choose a disc, then Insert disc and resume.",
      RECOMP_RUNTIME_UI_INT, 1, 1, 1, nullptr, 0, nullptr},
     {"media.insert", "Disc", "Insert disc and resume", "Change the disc while the game keeps running.",
@@ -77,6 +80,7 @@ int cb_get(void *, const RecompRuntimeUiItem *item, int *out) {
     else if (is(item, RECOMP_RUNTIME_UI_KEY_FMV_FILTER)) *out = g_video.fmv_filter;  // config value == choice index
     else if (is(item, "graphics.texture_filter")) *out = g_video.texture_filter;
     else if (is(item, "graphics.render_thread")) *out = g_video.render_thread;
+    else if (is(item, "graphics.frame_generation")) *out = g_video.frame_generation;
     else if (is(item, RECOMP_RUNTIME_UI_KEY_PAUSE_IN_MENU)) *out = g_pause_in_menu ? 1 : 0;
     else if (is(item, "media.disc")) *out = g_disc;
     else return 0;
@@ -89,6 +93,7 @@ int cb_set(void *, const RecompRuntimeUiItem *item, int v) {
     else if (is(item, RECOMP_RUNTIME_UI_KEY_FMV_FILTER)) g_video.fmv_filter = v;
     else if (is(item, "graphics.texture_filter")) g_video.texture_filter = v;
     else if (is(item, "graphics.render_thread")) g_video.render_thread = v ? 1 : 0;
+    else if (is(item, "graphics.frame_generation")) g_video.frame_generation = v ? 1 : 0;
     else if (is(item, RECOMP_RUNTIME_UI_KEY_PAUSE_IN_MENU)) {
         g_pause_in_menu = v != 0;
         const bool want = g_pause_in_menu && recomp_runtime_ui_is_open(g_ui);
@@ -175,7 +180,7 @@ int p_attach(void *, void *, void *, const PsxMenuHost *host) {
     g_host = host;
     if (g_ui) recomp_runtime_ui_destroy(g_ui);
     const int discs = disc_count();
-    g_extra[2].maximum = discs > 1 ? discs : 1;
+    g_extra[3].maximum = discs > 1 ? discs : 1;
     // The host's texture-filter catalog (attach runs on the main thread, where
     // launcher_game_info may be called).
     g_extra[0].choices = kLegacyFilters;
@@ -210,7 +215,7 @@ int p_attach(void *, void *, void *, const PsxMenuHost *host) {
                    RECOMP_RUNTIME_UI_STANDARD_RESUME | RECOMP_RUNTIME_UI_STANDARD_RETURN_TO_LAUNCHER |
                    RECOMP_RUNTIME_UI_STANDARD_QUIT;
     cfg.extra_items = g_extra;
-    cfg.extra_item_count = discs > 1 ? 4 : 2;
+    cfg.extra_item_count = discs > 1 ? 5 : 3;
     g_ui = recomp_runtime_ui_create_standard(&cfg);
     if (!g_ui) { g_host = nullptr; return 0; }
     return 1;
-- 
2.43.0

